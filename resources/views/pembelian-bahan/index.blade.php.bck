@push('scripts')
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const checkAll = document.getElementById('checkAll');
    const checkboxes = document.querySelectorAll('.row-checkbox');
    const bulkBtn = document.getElementById('btn-bulk-delete');
    const countSpan = document.getElementById('count-checked');

    checkAll?.addEventListener('change', function() {
        checkboxes.forEach(cb => cb.checked = this.checked);
        updateBulkButton();
    });

    checkboxes.forEach(cb => {
        cb.addEventListener('change', updateBulkButton);
    });

    function updateBulkButton() {
        const checkedCount = document.querySelectorAll('.row-checkbox:checked').length;
        countSpan.textContent = checkedCount;
        bulkBtn.disabled = checkedCount === 0;
        
        if(checkedCount > 0) {
            bulkBtn.classList.remove('opacity-0', 'pointer-events-none');
            bulkBtn.classList.add('opacity-100');
        } else {
            bulkBtn.classList.add('opacity-0', 'pointer-events-none');
            bulkBtn.classList.remove('opacity-100');
        }
    }
    function confirmPayment(id) {
    Swal.fire({
        title: 'Konfirmasi Pelunasan',
        text: "Pastikan pembayaran faktur ini sudah diselesaikan.",
        icon: 'info',
        showCancelButton: true,
        confirmButtonColor: '#10b981',
        confirmButtonText: 'Ya, Sudah Lunas',
        customClass: { popup: 'rounded-[2rem]' }
    }).then((result) => {
        if (result.isConfirmed) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = `{{ url('pembelian-bahan/pelunasan') }}/${id}`; // Buat route pelunasan
            form.innerHTML = `@csrf @method('PATCH')`;
            document.body.appendChild(form);
            form.submit();
        }
    });
}
function confirmPelunasan(id) {
    Swal.fire({
        title: 'Konfirmasi Pelunasan?',
        text: "Status akan diubah menjadi Lunas!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#10b981',
        confirmButtonText: 'Ya, Lunaskan!'
    }).then((result) => {
        if (result.isConfirmed) {
            // Submit form secara manual lewat JS
            document.getElementById('form-pelunasan-' + id).submit();
        }
    })
}
    function singleDelete(id) {
        Swal.fire({
            title: 'Hapus data pembelian?',
            text: "Data yang dihapus tidak dapat dikembalikan.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#e11d48',
            confirmButtonText: 'Ya, Hapus',
            customClass: { popup: 'rounded-[2rem]' }
        }).then((result) => {
            if (result.isConfirmed) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `{{ url('pembelian-bahan') }}/${id}`;
                form.innerHTML = `@csrf @method('DELETE')`;
                document.body.appendChild(form);
                form.submit();
            }
        });
    }

    bulkBtn?.addEventListener('click', function() {
        Swal.fire({
            title: 'Hapus Massal?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#e11d48',
            confirmButtonText: 'Ya, Hapus Semua',
            customClass: { popup: 'rounded-[2rem]' }
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('bulk-delete-form').submit();
            }
        });
    });
</script>
@endpush